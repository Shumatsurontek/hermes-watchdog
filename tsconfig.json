{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react", "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitReturns": true,
    "skipLibCheck": true, "allowJs": false, "noEmit": true
  },
  "include": ["desktop/src", "desktop/generated/*.d.ts"]
}
