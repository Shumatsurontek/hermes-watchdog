        "at": {
          "title": "At",
          "type": "number"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "tool": {
          "default": "",
          "title": "Tool",
          "type": "string"
        },
        "status": {
          "default": "",
          "title": "Status",
          "type": "string"
        },
        "outcome": {
